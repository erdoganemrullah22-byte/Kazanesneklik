{
  "name": "kazan-esneklik",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @kazan/web dev",
    "build": "pnpm --filter @kazan/web build",
    "start": "pnpm --filter @kazan/web start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bash scripts/e2e.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:validate": "pnpm --filter @kazan/content validate",
    "db:local": "bash scripts/db-local.sh start",
    "db:local:stop": "bash scripts/db-local.sh stop",
    "db:generate": "pnpm --filter @kazan/db generate",
    "db:migrate": "pnpm --filter @kazan/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @kazan/db migrate:dev",
    "db:validate": "pnpm --filter @kazan/db validate",
    "icons": "pnpm --filter @kazan/web icons",
    "secret-scan": "node scripts/check-client-bundle.mjs"
  },
  "devDependencies": {
    "@kazan/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
