# Kazan Esneklik — ortam değişkenleri (değersiz şablon).
# Yerelde: bu dosyayı apps/web/.env.local olarak kopyala ve doldur.
# Gerçek değerleri ASLA bu dosyaya, koda, issue'ya ya da sohbete yazma (plan 10.14).
#
# UYARI: .env.local yalnızca YEREL değerler içindir. Üretim (Neon) adreslerini,
# Anthropic anahtarını ya da üretimin BETTER_AUTH_SECRET'ini bu dosyaya koyma.
# Üretim değerleri yalnızca Vercel panelinde durur (README → Dağıtım rehberi).

# PostgreSQL (uygulama, havuzlu bağlantı). Yerel: pnpm db:local çıktısındaki URL.
DATABASE_URL=
# DATABASE_URL_UNPOOLED bu dosyada YOK, bilerek: migration için doğrudan (havuzsuz)
# adres yalnızca Vercel'de ya da tek seferlik komut satırında verilir:
#   DATABASE_URL_UNPOOLED='<adres>' pnpm db:migrate
# prisma.config.ts .env.local içindeki DATABASE_URL_UNPOOLED'ı zaten yok sayar.

# Better Auth. Gizli değer üretmek için: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Sitenin tam adresi, ör. http://localhost:3000 ya da https://<proje>.vercel.app
BETTER_AUTH_URL=
# Kayıt ve girişe izin verilen e-posta (virgülle ayrılmış liste biçimi; büyük/küçük
# harf fark etmez). Boşsa kayıt ve giriş tamamen kapalı. Faz K'da en fazla 1 adres
# kabul edilir (plan 11.0.4, risk 26): ikinci adres kod değişikliği ister.
AUTH_ALLOWED_EMAILS=
# Kayıt penceresi: yalnızca "true" iken kayıt açılır (varsayılan false). Üretimde
# yalnızca ilk kayıt için kısa süre açılır, hemen kapatılır (README → 7. adım).
AUTH_SIGNUP_OPEN=false
# Bulut kodlama oturumunda önizleme (yalnızca Faz K): giriş isteğinin Origin'i,
# isteğin geldiği adresle aynıysa da kabul edilir (önizleme adresi önceden bilinmez).
# Vercel'de AÇMAYIN; yalnızca "true" kabul edilir.
AUTH_TRUST_REQUEST_HOST=false

# Anthropic API anahtarı: YALNIZCA barındırma panelinde (Vercel → Sensitive).
# Bu dosyaya ya da .env.local'e yazmaktan kaçın; yerelde gerekmez.
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-opus-5-5
# true olmadıkça gerçek AI çağrısı (POST /api/admin/ai/smoke) kapalıdır.
AI_LIVE=false
