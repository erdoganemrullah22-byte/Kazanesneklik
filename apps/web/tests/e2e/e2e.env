# E2E test environment — ONLY obviously fake, non-secret values.
# Read by scripts/e2e.sh and playwright.config.ts. These values always win over
# the shell; the only override is E2E_DATABASE_URL (CI points it at its
# postgres service). It must name a "*_e2e" database, on localhost unless CI
# (apps/web/scripts/e2e-db-guard.mjs): every run empties the auth tables.
E2E_DATABASE_URL=postgresql://kazan@localhost:54329/kazan_e2e
BETTER_AUTH_SECRET=e2e-only-not-a-secret-0000000000000000000000
BETTER_AUTH_URL=http://localhost:3100
AUTH_ALLOWED_EMAILS=izinli@example.com
AUTH_SIGNUP_OPEN=true
AI_MODEL_MAIN=claude-opus-5-5
AI_LIVE=false
